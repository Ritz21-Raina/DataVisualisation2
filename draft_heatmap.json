{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap of birth counts by state and ethnicity with gender filter (purple gradient).",
  "width": 600,
  "height": 300,
  "background": "#FFF8E7",
  "data": {
    "url": "https://raw.githubusercontent.com/Ritz21-Raina/DataVisualisation2/refs/heads/main/Data/dataset.csv",
    "format": {"type": "csv"}
  },
  "params": [
    {
      "name": "selectedSex",
      "value": "male",
      "bind": {
        "input": "select",
        "options": ["male", "female"],
        "name": "Gender: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.ethnicity !== 'overall'"
    },
    {
      "filter": "datum.sex == selectedSex"
    },
    {
      "calculate": "toNumber(datum.abs)",
      "as": "birth_count"
    },
    {
      "filter": "isFinite(datum.birth_count)"
    },
    {
      "calculate": "replace(datum.ethnicity, '_', ' ')",
      "as": "ethnicity_label"
    }
  ],
  "mark": "rect",
  "encoding": {
    "y": {
      "field": "state",
      "type": "ordinal",
      "axis": {"title": "State"}
    },
    "x": {
      "field": "ethnicity_label",
      "type": "ordinal",
      "axis": {
        "title": "Ethnicity",
        "labelAngle": -45,
        "labelFont": "Poppins",
        "labelFontSize": 14,
        "labelColor": "#5A5A5A"
      }
    },
    "color": {
      "field": "birth_count",
      "type": "quantitative",
      "scale": {
        "range": ["#f3e8ff", "#d8b4fe", "#a855f7", "#6b21a8"]
      },
      "legend": {"title": "Birth Count"}
    },
    "tooltip": [
      {"field": "state", "title": "State"},
      {"field": "ethnicity_label", "title": "Ethnicity"},
      {"field": "abs", "title": "Birth Count", "format": ","},
      {"field": "sex", "title": "Gender"}
    ]
  },
  "config": {
    "view": {"stroke": "transparent"},
    "axis": {
      "labelFont": "Poppins",
      "titleFont": "Poppins",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelColor": "#5A5A5A",
      "titleColor": "#5A5A5A"
    },
    "title": {"fontSize": 18, "fontWeight": "bold"},
    "background": "#fffafc"
  }
}
